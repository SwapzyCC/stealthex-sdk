{
  "name": "@swapzy/stealthex-sdk",
  "version": "0.1.0",
  "description": "Unofficial, fully typed TypeScript client for the StealthEX exchange API v4. Zero dependencies.",
  "keywords": [
    "stealthex",
    "crypto",
    "exchange",
    "swap",
    "cryptocurrency",
    "api",
    "sdk",
    "client",
    "typescript"
  ],
  "homepage": "https://github.com/SwapzyCC/stealthex-sdk#readme",
  "bugs": {
    "url": "https://github.com/SwapzyCC/stealthex-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SwapzyCC/stealthex-sdk.git"
  },
  "license": "MIT",
  "author": "Swapzy (https://swapzy.cc)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "llms.txt",
    "llms-full.txt"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build",
    "prepare": "npm run clean && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
